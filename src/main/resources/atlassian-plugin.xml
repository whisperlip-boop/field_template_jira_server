<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}" />
        <param name="plugin-icon">images/pluginIcon.png</param>
        <param name="plugin-logo">images/pluginLogo.png</param>
    </plugin-info>

    <!-- add our i18n resource -->
    <resource type="i18n" name="i18n" location="field-templates"/>

    <!-- Active Objects: 여기서 등록한 엔티티만 AO가 테이블을 만들어 관리한다 -->
    <ao key="ao-module">
        <description>field-templates AO entities</description>
        <entity>co.bskim.jira.fieldtemplate.model.Template</entity>
        <entity>co.bskim.jira.fieldtemplate.model.TemplateGroup</entity>
        <entity>co.bskim.jira.fieldtemplate.model.TemplateIssueType</entity>
        <entity>co.bskim.jira.fieldtemplate.model.TemplateRole</entity>
        <entity>co.bskim.jira.fieldtemplate.model.TemplateRestriction</entity>
        <entity>co.bskim.jira.fieldtemplate.model.TemplateUsageStat</entity>
        <entity>co.bskim.jira.fieldtemplate.model.PersonalTemplate</entity>
        <entity>co.bskim.jira.fieldtemplate.model.PersonalTemplateIssueType</entity>
        <entity>co.bskim.jira.fieldtemplate.model.PersonalTemplateProject</entity>
    </ao>

    <!-- REST API: /rest/field-templates/1.0/... -->
    <rest key="field-templates-rest" path="/field-templates" version="1.0">
        <description>field-templates REST resources</description>
    </rest>

    <!-- 어디서나(이슈 화면 삽입 위젯 포함, atl.general) 필요한 최소 공통 리소스만 여기 둔다.
         절대로 여기에 jira-projects-plugin CSS 의존성이나 관리 화면 전용 JS를 넣지 말 것 — 아래
         field-templates-issue-widget-resources가 atl.general(거의 모든 Jira 화면, 대시보드 포함)에
         이 모듈을 의존성으로 끌어오므로, 여기 있는 건 전부 사이트 전역에 로드된다. -->
    <web-resource key="field-templates-common-resources" name="field-templates Common Resources">
        <dependency>com.atlassian.auiplugin:ajs</dependency>

        <resource type="download" name="css/field-templates.css" location="/css/field-templates.css"/>
        <resource type="download" name="js/rest-client.js" location="/js/rest-client.js"/>
        <resource type="download" name="images/" location="/images"/>
    </web-resource>

    <!-- 프로젝트 설정/개인 템플릿/전역 관리 화면 전용 리소스. 이 화면들은 PageShell이 직접
         <script src>/<link> 태그로 다운로드 URL을 참조해서 불러오지, Jira의 context 배치 시스템을
         타지 않는다 — 그래서 여기 있는 jira-projects-plugin 의존성은 우리 화면에만 영향을 주고
         절대 다른 페이지(특히 대시보드)로 새어나가지 않는다.
         (버그 #32: 이 6개 의존성이 원래 field-templates-common-resources 쪽에 있었는데, 그게
         atl.general에 물려있는 issue-widget-resources의 의존 대상이라 전역에 로드됐고, 실제 운영
         서버에서 jira-projects-plugin 모듈 키가 우리가 검증한 8.13.0/8.17.1과 달라서 리소스 배치가
         깨지며 대시보드 가젯이 통째로 안 뜨는 장애로 이어짐 — 격리해서 재발 방지.) -->
    <!-- 버그 #35: jira-projects-plugin 사이드바 CSS를 모듈 하나씩(sidebar-styles/components-page-
         icons/summary-page-icons/...) 손으로 골라 의존성 선언하는 방식은 아이콘이 하나씩 새로 안
         보일 때마다(Components → Summary → Board...) 계속 두더지 잡기가 됨 — 사용자가 실 서버의
         진짜 페이지 소스를 보내줘서 확인해보니, 그 페이지는 애초에 개별 모듈이 아니라
         `jira.project.sidebar`/`com.atlassian.jira.projects.sidebar.init`이라는 **WRM 컨텍스트**로
         사이드바에 필요한 CSS를 통째로 묶어서 가져오고 있었음. 그래서 이제 개별 모듈을 나열하는 대신
         ProjectConfigServlet이 이 두 네이티브 컨텍스트를 그대로 requireResourcesForContext()하도록
         바꿈(아래 servlet 섹션 참고) — Jira가 그 사이드바 렌더링에 실제로 필요하다고 정의해둔 CSS를
         전부 자동으로 받아오므로, 앞으로 사이드바 관련 아이콘이 또 안 보이는 문제가 원천적으로
         재발하지 않는다. -->
    <web-resource key="field-templates-project-config-resources" name="field-templates Project Config Resources">
        <dependency>com.atlassian.auiplugin:ajs</dependency>
        <dependency>co.bskim.jira.field-templates:field-templates-common-resources</dependency>

        <resource type="download" name="js/project-config.js" location="/js/project-config.js"/>
        <resource type="download" name="js/personal-templates.js" location="/js/personal-templates.js"/>
        <resource type="download" name="js/global-admin.js" location="/js/global-admin.js"/>
    </web-resource>

    <!-- 프로젝트 관리자 설정 화면 -->
    <servlet key="project-config-servlet" name="Field Templates Project Config Servlet"
             class="co.bskim.jira.fieldtemplate.web.ProjectConfigServlet">
        <url-pattern>/field-templates/project-config</url-pattern>
    </servlet>
    <!-- atl.jira.proj.config 사이드바는 서브섹션이 "summary"가 아니라 projectgroup1~4로 고정되어 있음
         (jira-project-config-plugin의 atlassian-plugin.xml에서 확인). 기존 그룹에 끼워넣지 않고
         우리 전용 그룹을 새로 선언해 사이드바 맨 아래에 별도 구획으로 노출한다. -->
    <web-section key="field-templates-group" location="atl.jira.proj.config" name="Field Templates" weight="50"/>
    <web-item key="field-templates-project-config-item" name="Field Templates" section="atl.jira.proj.config/field-templates-group" weight="10">
        <label>Field Templates</label>
        <link linkId="field-templates-project-config-link">/plugins/servlet/field-templates/project-config?projectKey=$project.key</link>
        <condition class="com.atlassian.jira.plugin.webfragment.conditions.UserIsProjectAdminCondition"/>
    </web-item>

    <!-- 전역 관리자 화면 -->
    <servlet key="global-admin-servlet" name="Field Templates Global Admin Servlet"
             class="co.bskim.jira.fieldtemplate.web.GlobalAdminServlet">
        <url-pattern>/field-templates/admin</url-pattern>
    </servlet>
    <!-- admin_plugins_menu도 위와 동일한 이유(서브섹션 필요)로 전용 그룹을 새로 선언 -->
    <web-section key="field-templates-admin-group" location="admin_plugins_menu" name="Field Templates" weight="50"/>
    <web-item key="field-templates-global-admin-item" name="Field Templates" section="admin_plugins_menu/field-templates-admin-group" weight="10">
        <label>Field Templates</label>
        <link linkId="field-templates-global-admin-link">/plugins/servlet/field-templates/admin</link>
    </web-item>

    <!-- 이슈 화면(Create/Edit/Transition) 삽입 위젯 — atl.general 컨텍스트라 일반 Jira 화면(대시보드
         포함 사실상 전부)에 자동 로드됨. 그래서 field-templates-common-resources 외에는 절대
         의존성을 추가하지 말 것 — jira-projects-plugin 같은 다른 플러그인 모듈에 대한 의존성을 여기
         붙이면 그 모듈 해석이 실패할 때 대시보드를 포함한 전체 페이지 리소스 배치가 깨질 수 있다
         (버그 #32 참고). -->
    <web-resource key="field-templates-issue-widget-resources" name="field-templates Issue Widget Resources">
        <dependency>com.atlassian.auiplugin:ajs</dependency>
        <dependency>co.bskim.jira.field-templates:field-templates-common-resources</dependency>

        <resource type="download" name="js/insert-widget.js" location="/js/insert-widget.js"/>

        <context>atl.general</context>
    </web-resource>

    <!-- 개인 템플릿 설정 화면 -->
    <servlet key="personal-templates-servlet" name="Field Templates Personal Templates Servlet"
             class="co.bskim.jira.fieldtemplate.web.PersonalTemplatesServlet">
        <url-pattern>/field-templates/personal-templates</url-pattern>
    </servlet>
    <web-item key="field-templates-personal-templates-item" name="Field Templates" section="system.user.options/personal" weight="100">
        <label>My Templates</label>
        <link linkId="field-templates-personal-templates-link">/plugins/servlet/field-templates/personal-templates</link>
    </web-item>

</atlassian-plugin>